# URL de la API desde el navegador (no desde el contenedor Docker)
# Local:       http://localhost:5000
# Docker:      http://localhost:5000  (nginx expone la API en puerto 5000)
# Producción:  https://tu-dominio.com/api  (según tu nginx.conf)
VITE_API_URL=http://localhost:5000
VITE_NODE_ENV=production

# Spotify — obtén las credenciales en https://developer.spotify.com/dashboard
VITE_SPOTIFY_CLIENT_ID=
VITE_SPOTIFY_CLIENT_SECRET=